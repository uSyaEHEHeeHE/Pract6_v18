<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="MidnightBlue"/>
    <SolidColorBrush x:Key="FieldBackground" Color="Black"/>
    <SolidColorBrush x:Key="PrimaryBackground" Color="DarkSlateGray"/>
    <SolidColorBrush x:Key="SecondaryBackground" Color="Black"/>
    <SolidColorBrush x:Key="TextColor" Color="GhostWhite"/>
    <SolidColorBrush x:Key="PrimaryForeground" Color="WhiteSmoke"/>
    <SolidColorBrush x:Key="BorderColor" Color="SlateGray"/>
    <SolidColorBrush x:Key="AccentColor" Color="CornflowerBlue"/>
    <SolidColorBrush x:Key="DangerText" Color="Firebrick"/>
</ResourceDictionary>
